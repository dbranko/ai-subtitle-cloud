# AI Subtitle Cloud — environment configuration.
# Copy to ".env" and adjust. ".env" is git-ignored: never commit real secrets.
# Every variable is optional; the defaults shown are used when it is unset.
# Real environment variables take precedence over this file.

# ---- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Storage -----------------------------------------------------------------
# Relative paths are resolved against the repository root.
DATA_DIR=./data
# SQLite database (must start with "file:"). Default: <DATA_DIR>/db/asc.sqlite
# DATABASE_URL=file:./data/db/asc.sqlite
# Individual directories. Defaults: <DATA_DIR>/subtitles, /cache, /logs, /jobs
# SUBTITLES_DIR=
# CACHE_DIR=
# LOGS_DIR=
# JOBS_DIR=

# ---- Network -----------------------------------------------------------------
# Everything binds to localhost by default. A service refuses to start on a
# non-loopback address unless AUTH_TOKEN is set.
API_HOST=127.0.0.1
API_PORT=7001
ADDON_HOST=127.0.0.1
ADDON_PORT=7000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=7002
# How often the worker reports that it is alive (milliseconds).
WORKER_HEARTBEAT_INTERVAL_MS=5000

# ---- Background jobs ---------------------------------------------------------
# How often an idle worker looks for queued jobs.
WORKER_POLL_INTERVAL_MS=1000
# How long a worker's claim on a job stays valid without renewal. If the worker
# dies, its jobs are picked up again after this time and resume where they stopped.
WORKER_LEASE_MS=30000
# Translations processed at the same time.
WORKER_CONCURRENCY=1
# Runs allowed per job (first run + automatic recoveries) before it is marked
# failed with "interrupted_by_restart". The owner can still retry it.
JOB_MAX_ATTEMPTS=3
# Requests allowed per segment when the AI answer is invalid, before the job fails.
SEGMENT_MAX_ATTEMPTS=3
# Largest subtitle upload, in bytes.
MAX_UPLOAD_BYTES=5242880
# Simulate translations without calling any AI provider (no cost). Useful to try
# the progress system. MOCK_AI_DELAY_MS is the simulated time per segment.
MOCK_AI=false
MOCK_AI_DELAY_MS=1000

# ---- Security ----------------------------------------------------------------
# Shared secret (min. 24 characters) required before exposing any service beyond
# localhost. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=
# Only for setups where another layer already restricts access (docker-compose.yml
# sets this because it publishes ports on 127.0.0.1 only). Leave false otherwise.
ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false

# ---- Docker Compose only -----------------------------------------------------
# Where container data lives: a host path (default ./data) or "asc-data" for the
# named Docker volume.
# ASC_DATA_MOUNT=./data
# Linux only: user/group id the containers run as (must own the data directory).
# ASC_UID=1000
# ASC_GID=1000

# ---- AI providers ------------------------------------------------------------
# API keys. Server-side only: never sent to the browser or to Stremio, never logged.
# The key of the preferred provider is required to translate.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Preferred provider: anthropic | openai | gemini
AI_PROVIDER=anthropic
# Model id. Empty = the provider's default
# (anthropic: claude-opus-5-5, openai: gpt-6.1-sol, gemini: gemini-3.8-flash).
# Cheaper Claude options: claude-sonnet-5-5, claude-haiku-5-5.
AI_MODEL=
# Optional second choice, used when the preferred provider keeps failing.
# May be the same provider with another model.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Reasoning depth: low | medium | high. Higher = slower and more expensive.
AI_EFFORT=medium
# Sampling temperature (0-2). Empty = provider default. Sent to OpenAI and Gemini
# only; current Claude models do not accept it (AI_EFFORT is their control).
AI_TEMPERATURE=
# Upper limit of generated tokens per request.
AI_MAX_OUTPUT_TOKENS=32000
# Largest number of subtitle entries sent in one request (5-200).
AI_MAX_SEGMENT_ENTRIES=60
# Default profile: natural | literal | cinematic | concise | custom
AI_TRANSLATION_PROFILE=natural
# Time limit for one provider request, and retries for temporary failures
# (rate limit, timeout, network, server error) before the fallback is used.
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_RETRIES=3
# Per-model prices used for cost estimates. Default: ./config/pricing.json
# PRICING_FILE=

# ---- Stremio add-on ----------------------------------------------------------
# Languages offered to Stremio, in order (comma separated target language ids).
STREMIO_TARGET_LANGUAGES=sr-Latn
# Automatic mode: when Stremio asks for a title that has no translation, start
# one in the background. false = only serve translations that already exist.
STREMIO_AUTO_TRANSLATE=true
# Safety cap: translations Stremio may start automatically per 24 hours
# (each one costs AI credits). 0 = unlimited.
STREMIO_DAILY_JOB_LIMIT=20
# Translation profile for Stremio requests. Empty = AI_TRANSLATION_PROFILE.
STREMIO_PROFILE=
# Override the language code or label shown in Stremio, e.g. to tell the two
# Serbian scripts apart:  sr-Cyrl=Српски (ћирилица)
STREMIO_LANGUAGE_LABELS=
# Address under which Stremio reaches the add-on. Stremio accepts only
# http://127.0.0.1 or an HTTPS address. Default: http://127.0.0.1:<ADDON_PORT>
# ADDON_PUBLIC_URL=
# Address of the dashboard (the add-on links to it as its progress page).
# Default: http://127.0.0.1:<API_PORT>
# DASHBOARD_PUBLIC_URL=

# ---- Subtitle sources --------------------------------------------------------
# OpenSubtitles official API (https://www.opensubtitles.com/consumers). Without a
# key only subtitles you upload yourself are used.
OPENSUBTITLES_API_KEY=
# Optional OpenSubtitles account: raises the daily download quota.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# The API requires every application to identify itself.
OPENSUBTITLES_USER_AGENT=AISubtitleCloud v0.1.0
# Source languages to look for, most preferred first (comma separated).
SOURCE_LANGUAGES=en
# Largest source subtitle accepted from a remote source, in bytes.
SOURCE_MAX_BYTES=2097152
# After a failed search for a title, wait this long before searching again.
SOURCE_RETRY_MINUTES=30

# ---- Cache -------------------------------------------------------------------
# Remove cached translations not used for this many days (0 = keep forever).
CACHE_MAX_AGE_DAYS=0
# Keep the translation cache below this size, removing the least recently used
# first (0 = unlimited). Files needed by running jobs are never removed.
CACHE_MAX_SIZE_MB=0
