// AI Subtitle Cloud — database schema.
// SQLite, single-owner installation. Every change must ship as a migration
// (`pnpm db:migrate:dev --name <change>`); never edit applied migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Liveness record written periodically by each long-running process.
/// Lets the API report whether the background worker is alive, and is the
/// basis for stale-worker detection in the Phase 3 job engine.
model ServiceHeartbeat {
  service    String   @id
  instanceId String
  pid        Int
  version    String
  startedAt  DateTime
  lastSeenAt DateTime

  @@map("service_heartbeats")
}

/// One translation request. The row is the single source of truth for the job:
/// the worker, the API, the SSE stream and Stremio all read state from here.
model TranslationJob {
  id             String  @id
  /// Identifies equivalent requests (source hash + target + profile + prompt/engine version).
  /// For a job that still has to find its source it is a provisional `media:<mediaKey>`.
  translationKey String
  /// Equals `translationKey` while the job is active, NULL once it is terminal.
  /// The unique index therefore allows at most one ACTIVE job per translation key.
  activeKey      String? @unique
  /// Identifies the media request (title/episode + video + target + profile) for jobs that
  /// were asked to find a source themselves. Lets a repeated request find the same job.
  mediaKey       String?
  /// JSON of the media query and optional pinned source candidate (discovery jobs only).
  mediaQuery     String?
  /// Translate even when an identical cached translation exists.
  force          Boolean @default(false)
  /// The job finished by reusing a cached translation; no AI request was made.
  cacheHit       Boolean @default(false)
  /// Not claimed by a worker before this time (used while waiting for an identical job).
  runAfter       DateTime?
  state          String
  /// "manual" (dashboard/API) or "stremio".
  origin         String  @default("manual")
  /// Run number: 1 for the first run, +1 for every recovery or owner retry.
  attempt        Int     @default(1)

  mediaTitle String
  mediaType  String?
  imdbId     String?
  season     Int?
  episode    Int?
  sourceName String?

  sourceLanguage     String?
  targetLanguage     String
  targetScript       String
  profile            String
  customInstructions String?
  /// Preferred provider and model chosen when the job was created.
  provider           String
  model              String
  /// JSON array of the provider/model pairs that actually produced the translation.
  usedModels         String?

  /// The source subtitle in the library; NULL until a discovery job has found one.
  sourceId   String?
  /// Path of the stored source subtitle, relative to the cache directory.
  sourceFile String?
  sourceHash String?
  /// File name of the finished translation, relative to the subtitles directory.
  outputFile String?

  percentage        Float   @default(0)
  totalEntries      Int     @default(0)
  completedEntries  Int     @default(0)
  totalSegments     Int     @default(0)
  completedSegments Int     @default(0)
  /// 1-based number of the segment being translated right now.
  currentSegment    Int?
  etaSeconds        Int?
  /// Short human-readable note about what is happening (e.g. a provider retry).
  statusDetail      String?

  retryCount   Int     @default(0)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)
  /// False when at least one request had no configured price (cost is then unknown).
  costKnown    Boolean @default(true)

  errorCode    String?
  errorMessage String?
  errorStage   String?

  cancelRequested Boolean   @default(false)
  /// Instance id of the worker processing the job, and when its claim expires.
  lockedBy        String?
  leaseExpiresAt  DateTime?

  createdAt   DateTime
  startedAt   DateTime?
  updatedAt   DateTime
  completedAt DateTime?

  segments JobSegment[]

  @@index([state, createdAt])
  @@index([translationKey])
  @@index([mediaKey])
  @@index([sourceId])
  @@map("translation_jobs")
}

/// Checkpoint: one accepted (validated) segment of a job. Lets a job resume
/// after a restart without translating finished segments again.
model JobSegment {
  jobId        String
  segmentIndex Int
  entries      Int
  attempts     Int
  durationMs   Int
  /// JSON of the engine's SegmentResult.
  result       String
  createdAt    DateTime

  job TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, segmentIndex])
  @@map("job_segments")
}

/// Append-only log of everything that changes. The auto-increment id is the
/// SSE event id: clients resume from the last id they saw.
model JobEvent {
  id        Int      @id @default(autoincrement())
  type      String
  jobId     String?
  /// JSON payload (the job or notification as the API returns it).
  payload   String
  createdAt DateTime

  @@index([createdAt])
  @@map("job_events")
}

/// Persistent completion/failure notification. The unique index guarantees one
/// notification per outcome of each run, however often the write is attempted.
model Notification {
  id        String    @id
  jobId     String
  attempt   Int
  kind      String
  title     String
  message   String
  createdAt DateTime
  readAt    DateTime?

  @@unique([jobId, kind, attempt])
  @@index([readAt, createdAt])
  @@map("notifications")
}

/// Library of source subtitles: every subtitle that was uploaded or downloaded,
/// stored once per distinct content. Also the "local" subtitle source.
model SourceSubtitle {
  id         String   @id
  /// Hash of the parsed content (independent of encoding and line endings).
  hash       String   @unique
  /// Where it came from: "upload" or a source adapter id such as "opensubtitles".
  provider   String
  /// The provider's own id of the file, when downloaded.
  externalId String?
  language   String?
  fileName   String?
  release    String?
  mediaType  String?
  imdbId     String?
  season     Int?
  episode    Int?
  /// Hash of the video file this subtitle was matched to, when known.
  videoHash  String?
  entries    Int
  sizeBytes  Int
  /// Path relative to the cache directory.
  file       String
  createdAt  DateTime
  lastUsedAt DateTime

  translations Translation[]

  @@index([imdbId, season, episode])
  @@map("source_subtitles")
}

/// Translation cache: one finished translation per translation key.
model Translation {
  id                 String   @id
  translationKey     String   @unique
  sourceId           String
  targetLanguage     String
  targetScript       String
  profile            String
  customInstructions String?
  promptVersion      String
  engineVersion      String
  /// JSON array of provider/model pairs that produced it.
  models             String
  /// File name relative to the subtitles directory.
  file               String
  entries            Int
  sizeBytes          Int
  /// JSON: validation result and processing statistics of the run that produced it.
  validation         String
  stats              String
  /// Job that produced this translation.
  jobId              String
  createdAt          DateTime
  lastUsedAt         DateTime

  source SourceSubtitle @relation(fields: [sourceId], references: [id])

  @@index([lastUsedAt])
  @@index([sourceId])
  @@map("translations")
}

/// Which translation answers a media request (so Stremio can be served from cache
/// without searching for a source again).
model MediaLink {
  mediaKey       String   @id
  translationKey String
  createdAt      DateTime
  updatedAt      DateTime

  @@index([translationKey])
  @@map("media_links")
}
